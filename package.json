{
  "name": "dsh-livestream-twitch",
  "version": "0.1.0",
  "description": "Twitch live-chat plugin for DeepSeek Harness: the broadcaster account reads chat over EventSub and replies through Helix, with a DSH agent writing the replies.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/agent.js",
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "twitch",
    "eventsub",
    "livestream"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify": "pnpm check && pnpm test && pnpm build && node scripts/check-secrets.mjs",
    "pack:release": "pnpm verify && pnpm pack"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "3.2.4"
  }
}
